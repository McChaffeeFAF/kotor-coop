# Copy to .env and fill in. Never commit the real .env.
# The name (or IP) games use to reach this server.
PUBLIC_HOST=coop.example.org
# This server's public IPv4 address, which the relay advertises. On a cloud
# VM whose network card has a private address behind 1:1 NAT (AWS, GCP,
# Oracle...), give both as PUBLIC/PRIVATE, e.g. 203.0.113.10/10.0.0.5, and
# uncomment allowed-peer-ip in turnserver.conf with the private one.
EXTERNAL_IP=203.0.113.10
# A long random secret shared by the service and coturn, e.g. `openssl rand -hex 32`.
TURN_SECRET=change-me
TURN_REALM=kotor-coop
# Seconds a join code lives at most (the host can reissue at any time).
CODE_TTL=43200
MAX_SESSIONS=200
